{
  "name": "@lebranc-gb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.tsx",
  "module": "src/main.tsx",
  "scripts": {
    "dev": "bun build ./src/index.html --outdir=dist --target=browser --hot",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "bun --hot dist/index.html"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@lebranc-gb/emulator": "file:../emulator"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
